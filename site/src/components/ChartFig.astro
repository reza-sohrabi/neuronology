---
// An interactive chart, loaded when it scrolls near the viewport. `piece` picks the module:
// "moe" = the routed-model post (src/explorer/olmoe.ts), "q36" = the Qwen3.6 post
// (src/explorer/qwen36.ts). Needs <LazyMount /> once on the page.
interface Props { chart: string; alt: string; piece?: 'moe' | 'q36' }
const { chart, alt, piece = 'moe' } = Astro.props;
---
<figure>
  <div class="mount chart" data-piece={piece} data-chart={chart} role="img" aria-label={alt}>
    <p class="loading">Chart loads when it scrolls into view (needs JavaScript).</p>
  </div>
  <figcaption><slot /></figcaption>
</figure>
